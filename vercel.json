{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "runtime": "@vercel/node@3.2.29"
    }
  },
  "redirects": [
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/user/dashboard.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin/dashboard.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/register.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/auth/login.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/auth/register.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/auth/logout.php",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin-login",
      "destination": "/admin-login.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}